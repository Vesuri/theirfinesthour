# NOTE: gitignore has no inline-comment syntax; comments go on their own line.

# --- OS / local tooling state ------------------------------------------------
.DS_Store
.claude/*.lock
__pycache__/
*.pyc

# FS-UAE writes a .uaem metadata sidecar next to every file in a directory it
# mounts as an Amiga hard drive.
*.uaem
*.uss

# --- Copyrighted / captured material: kept LOCAL only, never committed -------
# tmp/ holds the WHDLoad install archives and their unpacked game data, traces,
# memory dumps, screenshots and input recordings.  Game screenshots are
# copyrighted captures, and *.rom/*.adf/*.lha/*.slave guard against an image or
# archive landing at the repo root.
/tmp/
*.png
*.rom
*.adf
*.lha
*.slave
*.bin
*.rec

# --- Emulator / debugger run state --------------------------------------------
/amiga/.run/

# --- Build output ------------------------------------------------------------
build/
*.o
